{
  "rules": {
    "online": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "$conn": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        }
      }
    },
    "stats": {
      ".read": true,
      "total": {
        ".write": "auth != null",
        ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
      },
      "daily": {
        "$date": {
          ".write": "auth != null",
          ".validate": "$date.matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/) && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        }
      }
    },
    "chat": {
      ".read": true,
      ".indexOn": ["t"],
      "$id": {
        ".write": "auth != null && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['uid', 'name', 'text', 't']) && newData.child('t').val() === now && newData.parent().parent().child('lastPost').child(auth.uid).val() === now",
        "uid": { ".validate": "newData.val() === auth.uid" },
        "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
        "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200 && !newData.val().matches(/(https?:|www[.]|wa[.]me|t[.]me|bit[.]ly)/i)" },
        "t": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "lastPost": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.val() === now && (!data.exists() || newData.val() >= data.val() + 5000)"
      }
    }
  }
}
